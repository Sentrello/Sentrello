# --- database ---
# POSTGRES_PORT only affects docker-compose.dev.yml; change both if 5432 is taken
POSTGRES_PORT=5432
# The database this repository's suite runs against.
#
# One per repository, on port 5433, and never the shared `sentrello`. Every
# repository used to point here at that one database; on 2026-09-17 it held 313
# tables across 14 schemas because five suites were writing into it, and a run
# would fail on another repository's migrations naming files nobody had touched.
#
# It cost a whole afternoon again on 24 September. Three repositories still
# named the shared database while `test-databases.sh` was levelling the
# per-repository ones, so levelling did nothing the suite could see: Booking
# failed 54 tests against 59 organizations left behind by other suites, and four
# hypotheses were tested against a database the tests never opened.
#
# Create and level them all with:
#   bash Infrastructure/scripts/test-databases.sh
DATABASE_URL=postgres://sentrello:sentrello@localhost:5433/sentrello_t_core

# --- licensing (the verification key ships compiled into the app; nothing
# here can point it at a different one) ---
SENTRELLO_LICENSE_TOKEN_PATH=./secrets/license_token.jwt
SENTRELLO_LICENSE_SERVER_URL=https://sentrello.com   # used for hourly refresh

# --- instance ---
SENTRELLO_INSTANCE_ID=dev-instance
PORT=3000
# This server's public IP address, as the internet sees it. Required for
# filing UK VAT returns (HMRC wants it on every submission and a server behind
# NAT cannot discover it); everything else works without it.
SENTRELLO_PUBLIC_IP=

# --- auth ---
BETTER_AUTH_SECRET=change-me-32-bytes-min
SENTRELLO_BASE_URL=http://localhost:3000
# optional BYO Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email (Resend OR SMTP_*) ---
RESEND_API_KEY=
EMAIL_FROM="Sentrello <billing@yourbiz.com>"
# The platform's own mail — password resets, confirmations, invitations.
# Optional; both fall back to EMAIL_FROM. Never put a no-reply address in
# EMAIL_FROM itself, which is what your invoices are sent from.
# EMAIL_SYSTEM_FROM="Sentrello <no-reply@yourbiz.com>"
# EMAIL_REPLY_TO="support@yourbiz.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- license refresh ---
SENTRELLO_LICENSE_KEY=

# --- sign-up policy ---
# Unset (the default) means: only the first-run owner or an invited address may
# create an account. Set to true only if you want open registration.
SENTRELLO_ALLOW_SIGNUP=

# --- where this instance keeps its own files ---
# The licence key, the signed token, form attachments and the usage-reporting
# choice. In a container this is the mounted volume and the default is right.
# Running from a checkout there is no /data and nothing can be saved, so point
# it at a directory in the repo — both spellings are git-ignored.
#
# A relative path is resolved against the working directory of whatever is
# running, and that is not the same place twice: the API server runs from
# apps/server, tests run from the root. An absolute path is the way to have one
# directory rather than several.
SENTRELLO_DATA_DIR=./data

# --- the AGPL's offer of source ---
# Sentrello is AGPL-3.0. Section 13 of that licence owes the corresponding
# source to anybody who interacts with this over a network, whether or not they
# ever receive a copy — which is everybody who signs in, and every customer who
# opens a portal link.
#
# Unset, the instance points at the published repository, which is the honest
# answer while you are running it unmodified.
#
# **If you have changed the code, this must point at your version.** Our
# repository does not contain what you are serving, so publishing it discharges
# nothing on your behalf. Put the source somewhere your users can reach and name
# it here.
# SENTRELLO_SOURCE_URL=https://git.example.com/acme/sentrello
