#!/usr/bin/env bash
# Hold the commit convention: a subject of at most 72 characters, a blank line
# under it, and a body wrapped at 72.
#
# The rule has been written down since September and nothing enforced it, so
# the ceiling was a thing to remember rather than a thing that held. It stopped
# holding at 02:00 on 2026-09-29, on a subject of 79 — which is the hour the
# rule exists for.
#
# Wrapped-at-72 is checked as a warning rather than a refusal: a URL, a long
# path or a table row can be longer and breaking it would be worse. A subject
# over the ceiling has no such excuse, and is refused.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass deliberately:    git commit --no-verify   (say why, out loud)
set -euo pipefail

# Count characters, not bytes.
#
# `${#line}` is bytes under a C locale, and this project's prose is full of em
# dashes at three bytes each — so a line of 70 characters measured 76 and the
# hook nagged about prose that was already within the rule. A checker that
# cries wolf is one nobody reads.
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

MSG_FILE="$1"

# Read line by line rather than with `mapfile`, which is bash 4 and macOS
# ships 3.2 — the first version of this hook exited 127 on every commit, which
# is a worse outcome than the rule it was holding.
SUBJECT=""
SECOND=""
LONG=0
N=0
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in "#"*) continue ;; esac
  N=$((N + 1))
  if [ "$N" -eq 1 ]; then
    SUBJECT="$line"
  elif [ "$N" -eq 2 ]; then
    SECOND="$line"
  else
    # A single long word — a URL, a path, a file name — cannot be wrapped and
    # should not be broken.
    case "$line" in
      *" "*) [ "${#line}" -gt 72 ] && LONG=$((LONG + 1)) ;;
    esac
  fi
done < "$MSG_FILE"

# A merge, a revert or a fixup writes its own subject and is not ours to judge.
case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if [ "${#SUBJECT}" -gt 72 ]; then
  echo "commit-msg: the subject is ${#SUBJECT} characters and the ceiling is 72." >&2
  echo >&2
  echo "  $SUBJECT" >&2
  echo >&2
  echo "Say the problem rather than the action, and let the body carry the rest." >&2
  exit 1
fi

# A subject and a body want a blank line between them, or every reader's
# tooling treats the whole thing as one paragraph.
if [ "$N" -gt 1 ] && [ -n "$SECOND" ]; then
  echo "commit-msg: the line under the subject must be blank." >&2
  exit 1
fi

if [ "$LONG" -gt 0 ]; then
  echo "commit-msg: $LONG body line(s) run past 72 characters. Wrapping them" >&2
  echo "is the convention; this is a note rather than a refusal." >&2
fi

exit 0
