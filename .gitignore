node_modules/
dist/
*.tsbuildinfo
.env
.env.*
!.env.example
# NEVER commit private keys
secrets/
*.pem
!scripts/*.example
.DS_Store

# Local-only working notes and planning documents. They carry commercial and
# control-plane strategy, and this repository is public. They are not listed
# here by name: a file whose job is to keep those names out of a public
# repository cannot do it by writing them down. They live in
# .git/info/exclude, which is per-clone and never travels, and
# scripts/trace-guard.ts refuses them by pattern, which also catches
# `git add -f`.
MANIFEST.txt

dist-types/

# a checkout's own data directory (see SENTRELLO_DATA_DIR). Both spellings:
# a relative path is resolved against the process's working directory, and the
# API server runs from apps/server while tests run from the root.
/data/
apps/server/data/

# Declarations emitted beside their source, which is build output in the wrong
# place. `declaration: true` lives in tsconfig.base.json and every package sets
# an outDir, so a normal `tsc -b` writes to dist — but a tool that compiles a
# file without the package's tsconfig writes the .d.ts next to it instead. Forty
# three of those appeared in one package on 3 October and the only thing that
# noticed was the formatter, complaining about the indentation of generated code.
# Ignored so they can never be committed; lint still finds them locally, which
# is how they were found.
packages/**/src/**/*.d.ts
apps/**/src/**/*.d.ts
scripts/*.d.ts
